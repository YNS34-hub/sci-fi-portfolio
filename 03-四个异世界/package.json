{
  "name": "four-unrelated-worlds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.config.ts && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --config vite.config.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:e2e": "node tests/visual-qa.mjs desktop-1920",
    "qa:capture": "node tests/visual-qa.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
